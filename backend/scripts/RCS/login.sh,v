@#!/usr/bin/env bash
set -euo pipefail

LOGIN_URL="${TURBO_URL}${LOGIN_ENDPOINT}"
COOKIE_FILE="$BACKEND_DIR/data/cookie.txt"

echo "[INFO] Logging in to Turbonomic"

PAYLOAD="$(cat "$CREDS_FILE")"

HTTP_CODE=$(curl -ksL \
  -c "$COOKIE_FILE" \
  -o /tmp/turbo_login.out \
  -w "%{http_code}" \
  -X POST "$LOGIN_URL" \
  -d "$PAYLOAD"
)

if [[ "$HTTP_CODE" != "200" ]]; then
  echo "[ERROR] Login failed (HTTP $HTTP_CODE)"
  cat /tmp/turbo_login.out
  exit 1
fi

grep -qi JSESSIONID "$COOKIE_FILE" || {
  echo "[ERROR] Login failed: JSESSIONID not found in cookie"
  exit 1
}

echo "[INFO] Login successful, cookie generated"
@
