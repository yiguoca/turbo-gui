
CPP-28232: UAT
=================================
1. get the login cookie file
   $ curl -k -c cookie.txt -v -X POST "https://turbonomic.autodatacorp.org/api/v3/login"   -d "username=yi.guo.admin&password=Wd\$1368000ltdkl"


2. generate all_vms.json file (all the VMs in Turbonomic)
   $ ./get_all_vms

3. generate list of all the VMs
   $ cat vms_all.json | jq -r '.[] | "\(.displayName) \(.uuid)"'  > list.allvms

4. generate list of all ua hosts
   $  cat list.allvms |grep -i "\-u1cp" > list.ua.vms
    cat list.allvms |grep -i "\-u1cp" |awk '{print $3}'|tr 'A-Z' 'a-z' > list.ua.allhosts

5. $ chk_ping ua.allhosts
   remove the failed host from list.ua.allhosts

6. copy ssh key (if needed)
   $ cat list.ua.allhosts |while read host; do ssh-copy-myid  $host; done

7. $ chk_ssh ua.allhosts

8. check OS and generate centos list
   $ chk_os ua.allhosts
   $ chk_os ua.allhosts |grep CentOS|awk '{print $1}' > list.ua.centos

9. generate centos.vm_uuid.log
   $  cat list.ua.centos| while read host; do printf "$host    "; cat vms_all.json | jq -r '.[] | "\(.displayName) \(.uuid)"' |grep -iw $host; done > centos.vm_uuid.log

10. generate the table (md file saved in table.md)
   $ create_md_table

11. copy/paste the table.md file into jira 
